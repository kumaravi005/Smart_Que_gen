# =============================================================================
# Omega Question Paper Generator - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to create a local, git-ignored configuration:
#      cp .env.example .env.local
# 2. Replace the placeholder values below with your real Supabase credentials.
# 3. Restart the Vite development server (`npm run dev`) to pick up new variables.
#
# HOW TO FIND YOUR CREDENTIALS:
# 1. Go to https://supabase.com/dashboard/projects
# 2. Select your project (or click "New Project" to create one)
# 3. Navigate to: Project Settings (gear icon) -> "Data API" or "API"
# 4. Copy "Project URL" into VITE_SUPABASE_URL
# 5. Copy "anon public" key into VITE_SUPABASE_ANON_KEY
# =============================================================================

# Your Supabase project URL (must start with https://)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous public API key (client-safe, protected by RLS)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key